{
  "name": "koishi-plugin-minimax-vits-plus",
  "description": "基于 koishi-plugin-minimax-vits 改进版，使用 MiniMax TTS 生成语音，深度适配 ChatLuna",
  "version": "1.0.2",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./esm/index.js",
      "require": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "esm",
    "readme.md"
  ],
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "minimax",
    "tts",
    "vits",
    "chatluna",
    "voice",
    "speech"
  ],
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.16.0",
    "koishi": "^4.18.10",
    "silk-wasm": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "silk-wasm": {
      "optional": true
    }
  },
  "dependencies": {
    "form-data": "^4.0.0"
  },
  "inject": {
    "optional": [
      "console",
      "chatluna"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gt4404gb/minimax-vits-plus.git"
  },
  "bugs": {
    "url": "https://github.com/gt4404gb/minimax-vits-plus/issues"
  },
  "homepage": "https://github.com/gt4404gb/minimax-vits-plus#readme",
  "koishi": {
    "preview": true,
    "description": {
      "en": "MiniMax VITS TTS plugin (improved fork)",
      "zh": "基于 minimax-vits 改进版，修复控制台服务注册问题"
    },
    "service": {
      "implements": [
        "minimax-vits"
      ]
    }
  }
}
